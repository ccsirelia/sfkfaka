# Run npm run setup to generate unique secrets and a random admin password.
PORT=3200
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3200
ENCRYPTION_KEY=replace-with-64-hex-characters
SESSION_SECRET=replace-with-64-hex-characters
ADMIN_PASSWORD_HASH=generated-by-setup
DATA_DIR=./data
# Set to 1 ONLY when exactly one trusted reverse proxy sits in front of Node.
TRUST_PROXY=0
